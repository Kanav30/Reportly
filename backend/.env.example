# Reportly Backend — Environment Variables
# Copy this file to .env and fill in real values

# Firebase service account key path (relative to backend/ directory)
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Gemini API Key for Vision extraction (optional - users can supply their own)
GOOGLE_API_KEY=

# Comma-separated list of allowed frontend origins for CORS
# Example: http://localhost:5173,https://your-app.web.app
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Project ID (must match your Firebase project)
FIREBASE_PROJECT_ID=
