rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A user can read only their own profile.
    // Profile writes are performed by the trusted backend.
    match /users/{uid} {
      allow read: if ownsUser(uid);
      allow write: if false;

      // A user can read only their own saved reports.
      // The backend handles all report creation, updates and deletion.
      match /reports/{reportId} {
        allow read: if ownsUser(uid);
        allow write: if false;
      }
    }

    // The backend uses Firebase Admin SDK, which bypasses these rules.
    // Browser clients cannot access the root-level report mirror.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Connection-test records are not accessible from browser clients.
    match /_connection_tests/{docId} {
      allow read, write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
